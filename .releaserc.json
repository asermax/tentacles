{
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "printf %s \"${nextRelease.version}\" > VERSION && pnpm --filter @tentacles/plugin build"
      }
    ],
    ["@semantic-release/npm", { "pkgRoot": "apps/plugin/build/out/pi" }],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "apps/plugin/scripts/publish-marketplace.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["VERSION", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
