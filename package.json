{
  "name": "tentacles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck && pnpm run typecheck-tools && pnpm run lint",
    "lint": "oxlint && oxfmt --check .",
    "fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "lockfile:check": "pnpm install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "typecheck": "turbo run typecheck",
    "typecheck-tools": "tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "deploy": "APP_ENV=production varlock run -- pnpm --filter @tentacles/deploy deploy",
    "prepare": "effect-tsgo patch && lefthook install"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.3",
    "@oxlint/plugins": "1.92.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.19.2",
    "effect": "4.1.3",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "semantic-release": "25.0.9",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "varlock": "1.24.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.3.0"
}
