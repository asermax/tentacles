# Variables the deploy and the Worker read. Checked in, without secret values:
# local values go in .env.local and deploy values in .env.production.local, both
# out of git. The plugin's variables are the helper's runtime configuration and
# are not listed here. Validate with `pnpm exec varlock load`; run a command with
# the values injected with `pnpm exec varlock run -- <command>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Which set of values applies: development for checks and tests, production for
# the deploy, which stops before touching anything when a secret is missing.
# @type=enum(development, production)
APP_ENV=development

# The provider whose stack apps/deploy runs.
# @type=enum(cloudflare)
TENTACLES_PROVIDER=cloudflare

# The bearer key every Worker API request carries.
# @sensitive @required=forEnv(production) @type=string(minLength=32)
TENTACLES_API_KEY=

# The Claude subscription token the egress adds to the Claude container's calls
# to api.anthropic.com.
# @sensitive @required=forEnv(production) @type=string
TENTACLES_CLAUDE_TOKEN=

# The GitHub token the egress adds to the workspace containers' git calls.
# @sensitive @required=forEnv(production) @type=string
TENTACLES_GITHUB_TOKEN=

# HMAC key that signs the Browser Run session id in a browser's CDP address.
# @sensitive @required=forEnv(production) @type=string(minLength=32)
TENTACLES_CDP_SECRET=
