			if (!pausable || paused) return;
			ws.pause();
			paused = true;
		}
		function resumeWebSocket() {
			if (!pausable || !paused) return;
			ws.resume();
			paused = false;
		}
		function takeBuffer() {
			const chunk = buffer;
			buffer = [];
			bufferSize = 0;
			if (error === void 0) resumeWebSocket();
			return chunk;
		}
		function deliver() {
