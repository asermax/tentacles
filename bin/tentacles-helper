var check = (sources, decode) => {
	const items = [];
	const problems = [];
	const owners = /* @__PURE__ */ new Map();
	for (const source of sources) {
		const decoded = decode(source);
		if (isFailure(decoded)) {
			problems.push({
				path: source.path,
				message: decoded.failure
			});
			continue;
		}
		const owner = owners.get(decoded.success.name);
		if (owner != null) {
			problems.push({
				path: source.path,
				message: `name '${decoded.success.name}' is already used by ${owner}`
			});
			continue;
		}
		owners.set(decoded.success.name, source.path);
		items.push(decoded.success);
	}
	return {
		items,
		problems
	};
