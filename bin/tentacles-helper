/** A context path is checked by its stat alone: nothing in a folder is read here. */
var readContext = (path) => gen(function* () {
	const info = yield* statPath(path);
	if (!info.isDirectory() && !info.isFile()) return yield* fail$3(problemOf(path, "is not a file or a folder"));
	const source = resolve(path);
	const target = basename(source);
	return info.isDirectory() ? {
		type: "directory",
		source,
		target
	} : {
		type: "file",
		source,
		target
	};
});
/** A problem on every context path whose name an earlier path already has. */
var duplicateNames = (paths) => {
	const firstByName = /* @__PURE__ */ new Map();
	return paths.flatMap((path) => {
		const name = basename(resolve(path));
		const first = firstByName.get(name);
		if (first == null) {
			firstByName.set(name, path);
			return [];
		}
		return [problemOf(path, `has the same name as ${first}`)];
	});
};
/** Checks every path with the kind's reader (a stat for context paths, a read of the definition file for skills and agents), adds the problems the kind finds across the readable ones, and builds the result only when there is none. */
var checkPaths = (paths, read, problemsOf, build) => gen(function* () {
	const [reads, unreadable] = yield* partition(paths, read, { concurrency: "unbounded" });
	const problems = [...unreadable, ...problemsOf(reads)];
	return problems.length > 0 ? yield* fail$3(problems) : build(reads);
});
var checkSkillPaths = (paths) => checkPaths(paths, readSkill, (reads) => checkSkills(reads.map((read) => read.skill)).problems, (reads) => {
	const replaced = new Set(reads.map((read) => read.replaced));
	return {
		sources: reads.flatMap((read) => read.sources),
		filter: (path) => !replaced.has(path)
	};
});
var checkAgentPaths = (paths) => checkPaths(paths, readAgent, (reads) => checkAgents(reads.map((read) => read.agent)).problems, (reads) => ({ sources: reads.flatMap((read) => read.sources) }));
