var connection = (sessionId, print) => gen(function* () {
	const reader = yield* (yield* openSessionSocket(sessionId)).reader;
	let isConnected = false;
	while (true) for (const chunk of yield* reader.pull) {
		const received = yield* decodeState(isString$1(chunk) ? chunk : textDecoder.decode(chunk));
		const state = isConnected ? received : yield* withLastEntry(sessionId, received);
		isConnected = true;
		yield* print(StateLine.make({
			sessionId,
			state
		}));
	}
}).pipe(scoped);
/**
* Holds one session's socket and prints a line per state. When the socket
* cannot open or drops, the status call tells a session that does not exist,
* which ends its watch with a failure line, from one to reconnect to.
*/
var watchSession = (sessionId, print) => gen(function* () {
	while (true) {
		yield* exit(connection(sessionId, print));
		if (yield* (yield* TentaclesClient).sessions.status({ params: { sessionId } }).pipe(as(false), catchTag("SessionNotFound", () => succeed$1(true)), orElseSucceed(() => false))) return yield* print(MissingLine.make({
			sessionId,
			error: new SessionNotFound({ sessionId })
		}));
		yield* sleep(reconnectAfter);
	}
}).pipe(orElseSucceed(() => void 0));
/** One socket per session, each printing its own lines; the other sockets go on when one ends. */
var watchSessions = (sessionIds, print) => forEach(sessionIds, (sessionId) => watchSession(sessionId, print), {
	concurrency: "unbounded",
	discard: true
}).pipe(provide(TentaclesClientLive), orElseSucceed(() => void 0));
// src/helper/cli.ts
var encodeResult = encodeSync(CommandResultJson);
var encodeLine = encodeSync(WatchLineJson);
var decodeSessionIds = decodeUnknownEffect(ArraySchema(SessionId));
var main = (argv) => gen(function* () {
	const [name = "", ...rest] = argv;
	if (name === "watch") return yield* watchSessions(yield* decodeSessionIds(rest), (line) => log(encodeLine(line)));
	return yield* log(encodeResult(isCommandName(name) ? yield* runCommand(name, rest[0] ?? "{}") : HelperError.make({ message: `Unknown command "${name}".` })));
});
runPromise(main(process.argv.slice(2)).pipe(catch_$1((error) => log(encodeResult(HelperError.make({ message: String(error) })))), provide([layer, NodeWebSocketConstructor])));
export {};
