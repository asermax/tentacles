var readSkill = (path) => gen(function* () {
	yield* inspect(path, "folder");
	const root = resolve(path);
	const folder = basename(root);
	const skillPath = join(root, skillFile);
	const missing = problemOf(path, `has no ${skillFile}`);
	const info = yield* tryPromise({
		try: () => stat(skillPath),
		catch: (cause) => isNotFound(cause) ? missing : problemOf(path, `cannot be read: ${String(cause)}`)
	}).pipe(filterOrFail((found) => found.isFile(), () => missing));
	const { text, source } = definitionFile(`${folder}/${skillFile}`, yield* readText(skillPath, path), info.mode & 511);
