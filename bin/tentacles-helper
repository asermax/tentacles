var checks = {
	skills: checkSkillPaths,
	agents: checkAgentPaths,
	context: checkContextPaths
};
var pack = (kind, { sources, ...options }) => tryPromise({
	try: async () => {
		const chunks = [];
		await pipeline(packTar(sources, {
			dereference: true,
			baseDir: "/",
			...options
		}), createGzip(), async (packed) => {
			for await (const chunk of packed) chunks.push(chunk);
		});
		return Buffer.concat(chunks);
	},
	catch: (cause) => [problemOf(`the ${kind} archive`, `cannot be packed: ${String(cause)}`)]
}).pipe(filterOrFail((archive) => archive.byteLength <= maxArchiveBytes, (archive) => [problemOf(`the ${kind} archive`, `is ${megabytes(archive.byteLength)}, over the ${megabytes(maxArchiveBytes)} limit`)]));
var archiveOf = (kind, paths) => gen(function* () {
	if (paths.length === 0) return;
	return yield* checks[kind](paths).pipe(flatMap((checked) => pack(kind, checked)));
}).pipe(result$1);
/** Checks every path the agent passed, kind by kind, and packs each kind that had paths into an archive; fails with every problem of every path, never at the first. */
var packSpawnArchives = (paths) => gen(function* () {
	const results = yield* all$1(map$8(paths, (kindPaths, kind) => archiveOf(kind, kindPaths)), { concurrency: "unbounded" });
	if (Object.values(results).some(isFailure)) return yield* fail$3(Rejected.make(map$8(results, (result) => isFailure(result) ? result.failure : [])));
	const archives = {};
	for (const kind of archiveKindNames) {
		const result = results[kind];
		if (isSuccess$1(result) && result.success != null) archives[kind] = result.success;
	}
	return archives;
});
