		if (failure !== void 0) return fail$3(failure);
		if (done$2 !== void 0) return done(done$2.leftover);
		return matchEffect(upstream, {
			onSuccess: (input) => {
				const out = [];
				return emit(out, step(input, out)) ?? pull;
			},
