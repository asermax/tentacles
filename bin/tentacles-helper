var frontmatterPattern = /^(---[ \t]*\r?\n)(?:([\s\S]*?)(\r?\n))?(---[ \t]*(?:\r?\n|$))/;
var plainLinePattern = /^([A-Za-z0-9_][\w.-]*):[ \t]+(\S.*?)[ \t]*(\r?)$/;
var indentedPattern = /^[ \t]+\S/;
var isPlainValue = (value) => !/^["'|>]/.test(value);
var isInvalidAlone = (line) => {
