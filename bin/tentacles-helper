var parseLine = (line, out, ignoreEmptyLines, unterminated) => {
	if (ignoreEmptyLines && /^[ \t]*$/.test(line)) return;
	try {
		out.push(JSON.parse(line));
	} catch (cause) {
		return new NdjsonError({
			kind: "Unpack",
			reason: "InvalidJson",
			unterminated,
			cause
		});
	}
